  "cues": [
    {"id":"yujian","text":"御剑，去。","role":"hero","speaker":"孙小果"},
    {"id":"wanjian","text":"万剑，随我！","role":"hero","speaker":"孙小果"},
    {"id":"wulei","text":"五雷，诛邪！","role":"hero","speaker":"孙小果"},
    {"id":"sanmei","text":"三昧真火，起！","role":"hero","speaker":"孙小果"},
    {"id":"bingxin","text":"心定，剑不乱。","role":"hero","speaker":"孙小果"},
    {"id":"gudu","text":"蛊雾，散。","role":"hero","speaker":"孙小果"},
    {"id":"jiushen","text":"借酒，斩妖！","role":"hero","speaker":"孙小果"},
    {"id":"guanyin","text":"一息尚存。","role":"hero","speaker":"孙小果"},
    {"id":"ult-heaven","text":"以我一剑，破这天规！","role":"hero","speaker":"孙小果"},
    {"id":"ult-lotus","text":"莲华开处，生死由我！","role":"hero","speaker":"孙小果"},
    {"id":"ult-river","text":"命如江流，我偏逆行！","role":"hero","speaker":"孙小果"},
    {"id":"stage-0","text":"大圣失踪后，八十一难的名册开始自行改写。无籍剑仙孙小果循一截焦黑毫毛，踏入金蝉受贬的劫痕。","role":"narrator","speaker":"说书人"},
    {"id":"stage-1","text":"金色毫毛将孙小果引到陈府。门内每夜都传出婴儿的哭声，每到黎明，族谱便少一个名字。","role":"narrator","speaker":"说书人"},
    {"id":"stage-2","text":"孙小果顺洪江寻到一只永不腐烂的木板。血书上的字，每逢满月便会变成另一个人的笔迹。","role":"narrator","speaker":"说书人"},
    {"id":"boss-0","text":"你以为受贬的是金蝉？被贬的，是敢问价的人。","role":"monk","speaker":"缄口监院"},
    {"id":"boss-1","text":"真假不在纸上，在谁活着盖印。","role":"edict","speaker":"血诏司命"},
    {"id":"boss-2","text":"江水向东，账册向西。你要渡哪一边？","role":"river","speaker":"沉灯河伯"},
    {"id":"phase-0","text":"万声皆寂。诸戒，归身！","role":"monk","speaker":"缄口监院"},
    {"id":"phase-1","text":"印还在，命就断不了。","role":"edict","speaker":"血诏司命"},
    {"id":"phase-2","text":"借满江亡魂，再点一次灯。","role":"river","speaker":"沉灯河伯"},
    {"id":"victory","text":"这一难，破了。","role":"hero","speaker":"孙小果"},
    {"id":"defeat","text":"剑折，路未尽。","role":"hero","speaker":"孙小果"},
    {"id":"level","text":"剑意，更进一步。","role":"hero","speaker":"孙小果"},
    {"id":"weakness-0","text":"钟心露了，就是现在！","role":"hero","speaker":"孙小果"},
    {"id":"weakness-1","text":"诏令断了，趁它收刀！","role":"hero","speaker":"孙小果"},
    {"id":"weakness-2","text":"潮势已尽，斩它逆鳞！","role":"hero","speaker":"孙小果"},
    {"id":"omen-0","text":"听，钟声歇了。等它落印。","role":"hero","speaker":"孙小果"},
    {"id":"omen-1","text":"刀势未尽，先避开。","role":"hero","speaker":"孙小果"},
    {"id":"omen-2","text":"潮里留着一线生路。","role":"hero","speaker":"孙小果"},
    {"id":"victory-0","text":"监院的铁面落地，里面没有舌头。三页证词写着同一个收讫人，却被金漆涂去姓名。","role":"narrator","speaker":"说书人"},
    {"id":"victory-1","text":"司命的面具后挂着一排空白官印。它从不问诏令真假，只问印泥是否够红。","role":"narrator","speaker":"说书人"},
    {"id":"victory-2","text":"河伯倒下，灯芯里传出大圣的一声冷笑。别沿着他们写好的路找我。","role":"narrator","speaker":"说书人"}
  ]
}
